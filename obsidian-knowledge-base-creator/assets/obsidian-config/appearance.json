{
  "baseFontSize": 16,
  "showLineNumber": true,
  "showInlineTitle": true,
  "showFileExtension": false,
  "tabSize": 2,
  "spellcheck": false,
  "defaultViewMode": "source",
  "livePreview": true,
  "theme": "obsidian",
  "cssTheme": "",
  "accentColor": "#667eea",
  "interfaceFontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', sans-serif",
  "textFontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', sans-serif",
  "monospaceFontFamily": "'JetBrains Mono', 'Fira Code', 'Consolas', monospace",
  "translucency": false,
  "nativeMenus": true,
  "showRibbon": true,
  "showStatusBar": true,
  "showTabTitle": true,
  "showViewHeader": true,
  "collapseInlineTitle": false,
  "showBacklinks": true,
  "showOutline": true,
  "showTags": true,
  "showProperties": true,
  "propertiesInDocument": "visible",
  "showFrontmatter": true,
  "strictLineBreaks": false,
  "smartIndent": true,
  "autoPairBrackets": true,
  "autoPairMarkdown": true,
  "pasteFormat": "auto",
  "readability": true,
  "maxWidth": 800,
  "showIndentGuide": true,
  "showBullet": true,
  "foldHeading": true,
  "foldIndent": true,
  "clearUnusedEmbeds": false,
  "alwaysUpdateLinks": true,
  "newFileLocation": "current",
  "attachmentFolderPath": "attachments",
  "useMarkdownLinks": true,
  "newLinkFormat": "shortest",
  "useTab": false,
  "showUnsupportedFiles": false,
  "promptDelete": true,
  "trashOption": "system",
  "autoConvertHtml": false,
  "showInternalInlineTitle": true
}
