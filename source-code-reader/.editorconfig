root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
indent_size = 2
max_line_length = off
trim_trailing_whitespace = false

[*.py]
indent_size = 4
max_line_length = 120

[*.yaml]
indent_size = 2

[*.yml]
indent_size = 2

[*.json]
indent_size = 2

[*.{js,ts,jsx,tsx}]
indent_size = 2

[*.{css,scss,less}]
indent_size = 2

[*.{html,vue}]
indent_size = 2

[Makefile]
indent_style = tab

[*.sh]
indent_size = 4
