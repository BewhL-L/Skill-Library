# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# 所有文件的默认设置
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Python 文件
[*.py]
indent_size = 4
max_line_length = 120

# Markdown 文件
[*.md]
indent_size = 2
trim_trailing_whitespace = false

# YAML 文件
[*.{yaml,yml}]
indent_size = 2

# JSON 文件
[*.json]
indent_size = 2

# Shell 脚本
[*.sh]
indent_size = 4
end_of_line = lf

# Windows 批处理文件
[*.bat]
indent_size = 4
end_of_line = crlf

# 配置文件
[*.{config,ini,cfg}]
indent_size = 4

# 文本文件
[*.txt]
indent_size = 4

# Makefile
[Makefile]
indent_style = tab
